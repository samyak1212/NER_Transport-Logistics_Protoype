# ==============================================================================
# AI-Based Smart Logistics & Accessibility Intelligence Platform for NER
# Environment Configuration Template (.env.example)
# ==============================================================================

# --- Server & Runtime Ports ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# --- 1. Weather API (100% FREE - No API Key or Credit Card Required) ---
# Provider: Open-Meteo (https://open-meteo.com/)
# Provides hourly precipitation, rainfall, temperature, and weather codes.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# --- 2. Terrain & Elevation API (100% FREE - No API Key Required) ---
# Provider: Open-Meteo Elevation / NASA SRTM 30m
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation

# --- 3. GIS Map Tiles (100% FREE & Open-Source) ---
# Provider: CartoDB Basemaps / OpenStreetMap
# Options: 'dark_all', 'light_all', 'rastertiles/voyager'
MAP_TILE_PROVIDER=cartodb_dark
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# --- 4. Open Geocoding Service (100% FREE - OpenStreetMap Nominatim) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- 5. Optional Generative AI Assistant (100% FREE Tier Available) ---
# Provider: Google Gemini API (gemini-1.5-flash)
# How to get it:
# 1. Visit Google AI Studio: https://aistudio.google.com/
# 2. Sign in with any free Google account (no credit card needed).
# 3. Click "Get API Key" -> "Create API Key in new project".
# 4. Paste your key below. (If left blank, system uses built-in heuristic fallback).
GEMINI_API_KEY=
